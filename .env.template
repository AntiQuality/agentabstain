# AgentAbstain -- environment template
#
#   cp .env.template .env    # then fill in the keys you need
#
# Inference (src/scripts/run_inference.py) and evaluation (eval/runner.py)
# both load .env automatically; values already exported in your shell win.
# You only need the keys for the harnesses you actually run.

# -- Response judge + OpenAI SDK harness (src/configs/openaisdk_*.yaml) -----
# The LLM judge speaks the OpenAI API. Leave OPENAI_BASE_URL unset for
# api.openai.com, or point it at any OpenAI-compatible gateway
# (e.g. https://openrouter.ai/api/v1) and put that gateway's key here.
# Gateways that namespace model IDs (OpenRouter: openai/gpt-5.4) also need
# `judge_models[].model` in eval/configs/default.yaml changed to match.
OPENAI_API_KEY=
# OPENAI_BASE_URL=

# -- Claude SDK harness (src/configs/claudesdk_*.yaml) ----------------------
# The shipped configs pin the paper campaign's Bedrock model IDs
# (us.anthropic.*). Either fill in the Bedrock route below, or swap the
# config's `model:` field to a native ID (e.g. claude-sonnet-4-6) and set
# ANTHROPIC_API_KEY alone.
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_REGION=us-east-1

# -- Google ADK harness (src/configs/googleadk_*.yaml) ----------------------
# GOOGLE_API_KEY=

# -- OpenClaw harness (src/configs/openclaw_*.yaml) -------------------------
# Shipped configs route every OpenClaw model through OpenRouter.
# OPENROUTER_API_KEY=

# -- Optional ---------------------------------------------------------------
# Benchmark data directory (default: ./data)
# AGENTABSTAIN_DATA=
# openclaw CLI binary, if not on PATH (pin: npm install -g openclaw@2026.4.29)
# OPENCLAW_BIN=
